APP_ENV=development
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8100
# Required: the service refuses to start without it, because every /v1 endpoint would
# otherwise be reachable unauthenticated. Must match the backend's AI_SERVICE_INTERNAL_TOKEN.
AI_SERVICE_INTERNAL_TOKEN=
BACKEND_TOOL_GATEWAY_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
MODEL_MEMORY_MODE=shared

EMBEDDING_BACKEND=gemini
EMBEDDING_MODEL_NAME=gemini-embedding-001
EMBEDDING_MODEL_PATH=
EMBEDDING_VERSION=gemini-embedding-001-v1
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=8
EMBEDDING_DEVICE=cpu
EMBEDDING_DTYPE=float32
EMBEDDING_CACHE_FOLDER=.cache/huggingface
EMBEDDING_LOCAL_FILES_ONLY=false
EMBEDDING_PRELOAD=false
EMBEDDING_MAX_RETRIES=3

RERANK_BACKEND=bge
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_MODEL_PATH=
RERANK_DEVICE=cuda
RERANK_DTYPE=float16
RERANK_CACHE_FOLDER=.cache/huggingface
RERANK_LOCAL_FILES_ONLY=false
RERANK_SAFETENSORS_BACKEND=mmap
RERANK_BATCH_SIZE=2
RERANK_MAX_LENGTH=2048
RERANK_CANDIDATE_LIMIT=30
RERANK_MIN_MODEL_SCORE=0.15
RERANK_MODEL_WEIGHT=0.90
RERANK_FALLBACK_ENABLED=true

# Hosted alternative to local BGE: set RERANK_BACKEND=jina and provide a key.
JINA_API_KEY=
JINA_RERANK_URL=https://api.jina.ai/v1/rerank
JINA_RERANK_MODEL=jina-reranker-v3.5
JINA_RERANK_TIMEOUT_SECONDS=30
JINA_RERANK_SCORE_NORMALIZATION=auto
RERANK_INSTRUCTION=Truy xuất đoạn tài liệu nội bộ chính xác và đủ căn cứ để trả lời câu hỏi.

OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
# Khoá dự phòng cùng nhà cung cấp. Hạn mức tính theo project, nên khi khoá chính
# hết quota, provider sẽ thử khoá thứ hai với đúng model đang yêu cầu trước khi
# chuyển sang nhà cung cấp khác. Để trống nếu không có.
OPENAI_API_KEY_2=
GOOGLE_AI_API_KEY_2=
LLM_DEFAULT_PROVIDER=auto
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_CHAT_MODEL=gemini-3.6-flash
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
AGENT_MAX_MODEL_CALLS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MIDDLEWARE_MODEL_RETRIES=2
AGENT_COMPLEXITY_THRESHOLD=4

# LangChain migration gates.
LANGCHAIN_ENABLED=false
LANGGRAPH_ENABLED=false
LANGGRAPH_CHECKPOINT_BACKEND=memory
LANGGRAPH_CHECKPOINT_DATABASE_URL=
LANGGRAPH_CHECKPOINT_AUTO_SETUP=true
LANGGRAPH_STRICT_MSGPACK=true
# Empty or * means every role; otherwise use comma-separated role codes.
LANGCHAIN_AGENT_ROLES=
