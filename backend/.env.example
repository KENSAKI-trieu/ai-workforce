# AI Workforce backend configuration
# Copy this file to .env and provide unique secret values.

# Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_workforce_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Leave blank to derive the URL from the PostgreSQL fields above.
DATABASE_URL=

# Authentication
SECRET_KEY=
SEED_DEFAULT_PASSWORD=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0
WORK_QUEUE_NAME=ai-workforce:jobs
WORK_QUEUE_PROCESSING_NAME=ai-workforce:jobs:processing
WORK_QUEUE_DEAD_LETTER_NAME=ai-workforce:jobs:dead-letter
WORKER_HEARTBEAT_KEY=ai-workforce:worker:heartbeat

# Email delivery. Keep "outbox" for safe local development; use "smtp" only
# with secret values supplied by the deployment environment.
EMAIL_DELIVERY_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# MinIO / object storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
KNOWLEDGE_STORAGE_PATH=data/knowledge

# Cloudinary avatar storage. Keep the real secret in .env/deployment secrets only.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Standalone AI runtime. Leave blank for the in-process development fallback.
# Docker Compose sets AI_SERVICE_URL=http://ai-service:8100 for the backend.
AI_SERVICE_URL=
AI_SERVICE_INTERNAL_TOKEN=
AI_SERVICE_TIMEOUT_SECONDS=120
LANGGRAPH_ENABLED=false
LANGGRAPH_LEGACY_FALLBACK=true
# AI-service checkpoint settings when this file is loaded by Docker Compose.
LANGGRAPH_CHECKPOINT_BACKEND=memory
LANGGRAPH_CHECKPOINT_DATABASE_URL=
LANGGRAPH_CHECKPOINT_AUTO_SETUP=true
LANGGRAPH_STRICT_MSGPACK=true

# Knowledge embedding. Use "sentence_transformers" in an embedding worker with
# the optional ML dependencies installed. Deterministic mode is for local tests.
EMBEDDING_BACKEND=deterministic
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_VERSION=qwen3-embedding-v1
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_FOLDER=data/models/huggingface/hub
# Set true after the model has been downloaded to the Hugging Face cache.
EMBEDDING_LOCAL_FILES_ONLY=false
EMBEDDING_MAX_RETRIES=3
RAG_CHUNK_MIN_TOKENS=100
RAG_CHUNK_TARGET_TOKENS=450
RAG_CHUNK_MAX_TOKENS=700
RAG_CHUNK_OVERLAP_TOKENS=80
RAG_MIN_DENSE_SCORE=0.50
RAG_MIN_RELEVANCE_SCORE=0.50

# CORS
FRONTEND_URL=http://localhost:3000
