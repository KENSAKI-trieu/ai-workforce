# AI Workforce backend configuration
# Copy this file to .env and provide unique secret values.

# Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_workforce_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Leave blank to derive the URL from the PostgreSQL fields above.
DATABASE_URL=

# Authentication
SECRET_KEY=
SEED_DEFAULT_PASSWORD=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Refresh cookie. COOKIE_SECURE MUST be true in production -- the app refuses to start
# otherwise, because the cookie is a long-lived credential. Use COOKIE_SAMESITE=none
# (which requires COOKIE_SECURE=true) only when the frontend is on a different site than
# the API; leave it lax when they share one.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Login throttling. Needs Redis (REDIS_URL below). If Redis is unreachable, login is
# refused with 503 unless LOGIN_RATE_LIMIT_FAIL_OPEN=true.
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_MAX_PER_EMAIL=10
LOGIN_RATE_LIMIT_MAX_PER_IP=50
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_FAIL_OPEN=false

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379/0
WORK_QUEUE_NAME=ai-workforce:jobs
WORK_QUEUE_PROCESSING_NAME=ai-workforce:jobs:processing
WORK_QUEUE_DEAD_LETTER_NAME=ai-workforce:jobs:dead-letter
WORKER_HEARTBEAT_KEY=ai-workforce:worker:heartbeat

# Email delivery. Keep "outbox" for safe local development; use "smtp" only
# with secret values supplied by the deployment environment.
EMAIL_DELIVERY_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# MinIO / object storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
KNOWLEDGE_STORAGE_PATH=data/knowledge

# Cloudinary avatar storage. Keep the real secret in .env/deployment secrets only.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Standalone AI runtime. Leave blank for the in-process development fallback.
# Docker Compose sets AI_SERVICE_URL=http://ai-service:8100 for the backend.
# Whenever AI_SERVICE_URL is set, AI_SERVICE_INTERNAL_TOKEN is REQUIRED and must match
# the value in the ai-service .env -- the ai-service refuses to start without it and
# rejects calls that arrive with no credential.
AI_SERVICE_URL=
AI_SERVICE_INTERNAL_TOKEN=
AI_SERVICE_TIMEOUT_SECONDS=120
AI_SERVICE_ROUTER_TIMEOUT_SECONDS=15
# Engine per AI Employee, e.g. KNOWLEDGE=langgraph,LEGAL=langgraph. A role not listed
# follows LANGGRAPH_ENABLED. HR and agents under development stay deterministic.
AGENT_ENGINES=
LANGGRAPH_ENABLED=false
LANGGRAPH_LEGACY_FALLBACK=true
# AI-service checkpoint settings when this file is loaded by Docker Compose.
LANGGRAPH_CHECKPOINT_BACKEND=memory
LANGGRAPH_CHECKPOINT_DATABASE_URL=
LANGGRAPH_CHECKPOINT_AUTO_SETUP=true
LANGGRAPH_STRICT_MSGPACK=true

# Knowledge embedding. Gemini uses GOOGLE_AI_API_KEY above; deterministic mode
# remains available for isolated local tests.
EMBEDDING_BACKEND=gemini
EMBEDDING_MODEL_NAME=gemini-embedding-001
EMBEDDING_VERSION=gemini-embedding-001-v1
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_FOLDER=
# This flag only applies to local Hugging Face models.
EMBEDDING_LOCAL_FILES_ONLY=false
EMBEDDING_MAX_RETRIES=3
EMBEDDING_ALLOW_DETERMINISTIC_FALLBACK=true
RAG_CHUNK_MIN_TOKENS=100
RAG_CHUNK_TARGET_TOKENS=450
RAG_CHUNK_MAX_TOKENS=700
RAG_CHUNK_OVERLAP_TOKENS=80
RAG_MIN_DENSE_SCORE=0.50
RAG_MIN_RELEVANCE_SCORE=0.50

# CORS
FRONTEND_URL=http://localhost:3000
