# ---------------------------------------------------------------------------
# backend/.env for the production VPS.
#   cp deploy/backend.env.prod.example backend/.env
# Generate every secret fresh - never reuse the values from a test box.
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_workforce_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_URL=

SECRET_KEY=
# Leave empty in production. Only app.db.init_db reads it, and that seeder must
# never be run against a production database.
SEED_DEFAULT_PASSWORD=

# Refresh cookie. The app refuses to start with APP_ENV=production unless
# COOKIE_SECURE is true. samesite=lax is correct here because the app and API
# hostnames share the kensaki-vn.com registrable domain, so they are same-site.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# Overridden by the prod overlay, but keep it correct for one-off exec commands.
FRONTEND_URL=https://company.kensaki-vn.com

OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

REDIS_URL=redis://redis:6379/0

AI_SERVICE_URL=http://ai-service:8100
AI_SERVICE_INTERNAL_TOKEN=
# Must stay under Cloudflare's 100s proxy timeout.
AI_SERVICE_TIMEOUT_SECONDS=90
AI_SERVICE_ROUTER_TIMEOUT_SECONDS=15

EMBEDDING_BACKEND=gemini
EMBEDDING_MODEL_NAME=gemini-embedding-001
EMBEDDING_VERSION=gemini-embedding-001-v1
EMBEDDING_DIMENSION=768
EMBEDDING_DEVICE=cpu

KNOWLEDGE_STORAGE_PATH=data/knowledge
