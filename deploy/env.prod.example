# ---------------------------------------------------------------------------
# Root .env for the production VPS.
# Copy to the repository root as .env and fill in every value.
#   cp deploy/env.prod.example .env
# ---------------------------------------------------------------------------

# --- Public hostnames (no scheme, no trailing slash) ---
# Kept to two levels so Cloudflare's free Universal SSL (*.kensaki-vn.com)
# covers all three. A third level such as app.company.kensaki-vn.com would
# need Advanced Certificate Manager at $10/month.
APP_HOSTNAME=company.kensaki-vn.com
API_HOSTNAME=api-company.kensaki-vn.com
AI_HOSTNAME=ai-company.kensaki-vn.com

# --- Cloudflare Tunnel ---
# Zero Trust dashboard -> Networks -> Tunnels -> your tunnel -> install token.
TUNNEL_TOKEN=

# --- AI service wiring ---
AI_SERVICE_INTERNAL_TOKEN=

AI_EMBEDDING_BACKEND=gemini
AI_EMBEDDING_MODEL_NAME=gemini-embedding-001
AI_EMBEDDING_VERSION=gemini-embedding-001-v1
AI_EMBEDDING_DIMENSION=768
AI_EMBEDDING_DEVICE=cpu
AI_EMBEDDING_DTYPE=float32

AI_RERANK_BACKEND=jina
AI_RERANK_DEVICE=cpu
AI_RERANK_DTYPE=float32
JINA_RERANK_MODEL=jina-reranker-v3.5
JINA_API_KEY=

# NOTE: OPENAI_API_KEY / GOOGLE_AI_API_KEY are read from backend/.env (env_file),
# not from this file.
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Cloudflare's proxy times out at 100s waiting for the first byte (error 524).
# Keep the LLM timeout below that.
LLM_TIMEOUT_SECONDS=85
